# ============================================
# RellBot v2 — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# MongoDB Connection URI (required)
# Get a free cluster at: https://mongodb.com/atlas
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/botwa

# Groq AI API Key (required for .ai command)
# Get yours at: https://console.groq.com
GROQ_API=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
